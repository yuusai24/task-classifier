NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 管理用（サーバーのみで使用。ブラウザに公開しない）
SUPABASE_SERVICE_ROLE_KEY=

# Googleカレンダー連携（個別セッション予約枠の自動生成）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoom連携（予約確定時のZoom URL自動発行・録画のWebhook受信）
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# Vimeo連携（Zoom録画の自動アップロード先。Vimeo Pro以上のプランが必要）
VIMEO_ACCESS_TOKEN=

# Vercel Cronからの同期リクエストを保護するための秘密値（任意の文字列でよい）
CRON_SECRET=
